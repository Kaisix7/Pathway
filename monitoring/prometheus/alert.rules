groups:
  - name: pathway_alerts
    rules:
      - alert: ServiceDown
        expr: up{job="backend"} == 0
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: "Service {{ $labels.instance }} is down"
          description: "Service {{ $labels.instance }} has been offline for more than 30 seconds."

      - alert: HighErrorRate
        expr: sum(rate(pathway_http_requests_total{status_class="5xx"}[1m])) / sum(rate(pathway_http_requests_total[1m])) * 100 > 5
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "High error rate detected"
          description: "Error rate is {{ $value | printf \"%.2f\" }}% which is above the 5% threshold."

      - alert: LoadTestingDetected
        expr: sum(rate(pathway_http_requests_total[1m])) > 5
        for: 15s
        labels:
          severity: warning
        annotations:
          summary: "Load Testing / High Traffic Detected"
          description: "RPS is {{ $value | printf \"%.2f\" }} which indicates active load testing or heavy traffic."

      - alert: HighLatency
        expr: histogram_quantile(0.95, sum(rate(pathway_http_request_duration_seconds_bucket[5m])) by (le)) > 1.5
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "High latency detected on {{ $labels.instance }}"
          description: "95% of requests take more than 1.5s (current value: {{ $value | printf \"%.2f\" }}s)."

      - alert: HighClientErrorRate
        expr: sum(rate(pathway_http_requests_total{status_class="4xx"}[1m])) / sum(rate(pathway_http_requests_total[1m])) * 100 > 15
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "High client error rate (4xx)"
          description: "Client errors represent {{ $value | printf \"%.2f\" }}% of all requests."
